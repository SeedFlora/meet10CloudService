      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum(rate(http_requests_total{path=\"/predict\",status=~\"5..\"}[1m])) or vector(0)) / (sum(rate(http_requests_total{path=\"/predict\"}[1m])) > 0)) or vector(0)",
